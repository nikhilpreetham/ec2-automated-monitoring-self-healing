override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Credentials and secrets
.env
.env.*
*.pem
*.key
credentials
.aws/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
